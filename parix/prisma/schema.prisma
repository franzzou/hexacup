// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- UTILISATEURS ----------

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String? // null si connexion Google
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription    Subscription?
  accounts        Account[] // pour NextAuth (Google etc.)
  sessions        Session[]
  recommendations Recommendation[] // recommandations publiées par cet admin
  picks           UserPick[] // recommandations suivies personnellement
}

// Modèles requis par NextAuth (Google OAuth + Credentials)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Requis par l'adapter Prisma de NextAuth (même sans provider email/magic link actif)
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- ABONNEMENTS ----------

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INACTIVE
}

enum PlanType {
  ECONOMIQUE
  CLASSIQUE
  PREMIUM
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 PlanType?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sports SubscriptionSport[] // sports inclus dans l'abonnement
}

model SubscriptionSport {
  id             String @id @default(cuid())
  subscriptionId String
  sportId        String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  sport        Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, sportId])
}

// ---------- SPORTS ----------

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique // "Football", "Basketball", "Tennis"
  slug      String   @unique // "football", "basketball", "tennis"
  apiSource String // ex: "api-football", "api-basketball"
  createdAt DateTime @default(now())

  matches            Match[]
  subscriptionSports SubscriptionSport[]
  players            Player[]
}

// ---------- MATCHS ----------

enum MatchStatus {
  UPCOMING
  LIVE
  FINISHED
  POSTPONED
  CANCELED
}

model Match {
  id         String      @id @default(cuid())
  sportId    String
  externalId String // id renvoyé par l'API sportive
  homeTeam   String
  awayTeam   String
  league     String?
  country    String? // pays où se déroule la compétition, pour le filtre d'accueil
  venue      String? // stade/salle où se joue le match
  referee    String? // arbitre principal
  matchDate  DateTime
  status     MatchStatus @default(UPCOMING)
  homeScore  Int?
  awayScore  Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  sport           Sport            @relation(fields: [sportId], references: [id])
  stats           MatchStats?
  recommendations Recommendation[]
  lineups         MatchLineup[]

  @@unique([sportId, externalId])
  @@index([sportId, matchDate]) // liste des matchs du jour par sport
  @@index([status])
  @@index([country])
}

model MatchStats {
  id                 String  @id @default(cuid())
  matchId            String  @unique
  homeForm           String? // ex: "WWDLW"
  awayForm           String?
  h2hSummary         String? // résumé face-à-face
  analysis           String? @db.Text // analyse générale du match, rédigée par l'admin
  homeWinProbability Float? // % de chances de victoire à domicile (0-100)
  drawProbability    Float? // % de chances de match nul (sports concernés uniquement)
  awayWinProbability Float? // % de chances de victoire à l'extérieur (0-100)

  // Stats avancées football (xG/xGA = moyenne par match sur la saison)
  homeAvgXg  Float?
  homeAvgXga Float?
  awayAvgXg  Float?
  awayAvgXga Float?

  // Stats avancées basketball
  homeOffRating Float? // efficacité offensive (points marqués / 100 possessions)
  homeDefRating Float? // efficacité défensive (points concédés / 100 possessions)
  awayOffRating Float?
  awayDefRating Float?
  homePace      Float? // rythme de jeu estimé (possessions/match)
  awayPace      Float?

  // Stats avancées tennis
  homeServeWinPct  Float? // % de points gagnés au service
  awayServeWinPct  Float?
  homeReturnWinPct Float? // % de points gagnés au retour
  awayReturnWinPct Float?

  rawData   Json? // données brutes API pour flexibilité
  updatedAt DateTime @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// ---------- COMPOSITIONS ----------

enum MatchSide {
  HOME
  AWAY
}

model Player {
  id        String   @id @default(cuid())
  name      String
  position  String? // ex: "Attaquant", "Meneur", "Défenseur"
  sportId   String
  createdAt DateTime @default(now())

  sport         Sport               @relation(fields: [sportId], references: [id], onDelete: Cascade)
  lineupEntries MatchLineupPlayer[]
}

model MatchLineup {
  id        String    @id @default(cuid())
  matchId   String
  side      MatchSide
  formation String? // ex: "4-3-3"

  match   Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  players MatchLineupPlayer[]

  @@unique([matchId, side])
}

model MatchLineupPlayer {
  id          String  @id @default(cuid())
  lineupId    String
  playerId    String
  isStarter   Boolean @default(true)
  shirtNumber Int?
  note        String? // ex: "joueur clé à surveiller, retour de blessure"

  lineup MatchLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([lineupId, playerId])
}

// ---------- RECOMMANDATIONS ----------

enum RecommendationResult {
  PENDING
  WON
  LOST
  VOID
}

// Marché/type de pari, pour segmenter les recommandations au-delà du
// simple résultat du match et calculer un taux de réussite par catégorie
enum BetMarket {
  MATCH_WINNER // vainqueur du match / 1N2
  OVER_UNDER // plus/moins de buts ou points
  BOTH_TEAMS_SCORE // les deux équipes marquent (foot)
  HANDICAP // écart de points/buts
  SETS_GAMES // nombre de jeux/sets (tennis)
  CORNERS_CARDS // corners, cartons (foot)
  OTHER
}

model Recommendation {
  id       String    @id @default(cuid())
  matchId  String
  title    String // ex: "Plus de 2.5 buts"
  market   BetMarket @default(OTHER)
  analysis String    @db.Text // texte d'analyse (2-3 phrases justifiant le raisonnement)

  // Indice de confiance à facteurs pondérés (0-100 chacun), agrégés en
  // confidenceScore selon les poids définis dans src/lib/confidence.ts
  formScore       Int?
  h2hScore        Int?
  contextScore    Int?
  statsScore      Int?
  marketScore     Int?
  confidenceScore Float? // score agrégé, calculé et stocké à l'écriture

  odds      Float? // cote au moment de la recommandation, pour le ROI théorique
  watchOnly Boolean              @default(false) // tendance qui se dessine mais pas encore confirmée
  result    RecommendationResult @default(PENDING)
  createdBy String // id de l'admin qui l'a créée
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  match     Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  admin     User       @relation(fields: [createdBy], references: [id])
  userPicks UserPick[] // utilisateurs ayant suivi ce pronostic

  @@index([matchId])
  @@index([result])
  @@index([market])
}

// Suivi personnel : un utilisateur coche les recommandations qu'il a
// suivies (sur une plateforme de paris externe) pour retrouver son
// propre bilan gagné/perdu, basé sur le résultat déjà vérifié par l'admin.
model UserPick {
  id               String   @id @default(cuid())
  userId           String
  recommendationId String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationId])
}

// ---------- CONTACT ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ---------- SUIVI DE PERFORMANCE ----------

model PerformanceHistory {
  id          String   @id @default(cuid())
  sportId     String? // null = toutes catégories confondues
  period      String // ex: "2026-08" (mensuel) ou "2026-W31" (hebdo)
  totalCount  Int
  wonCount    Int
  successRate Float // % calculé, stocké pour affichage rapide
  updatedAt   DateTime @updatedAt

  @@unique([sportId, period])
}
