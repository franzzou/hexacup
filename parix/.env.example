# PostgreSQL connection string (Neon/Supabase en prod, instance locale en dev)
DATABASE_URL="postgresql://user:password@localhost:5432/pronostics_dev?schema=public"

# NextAuth — génère une valeur avec `npx auth secret`
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com > Identifiants > ID client OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (dashboard.stripe.com, mode test)
STRIPE_SECRET_KEY=""
# Signing secret du endpoint webhook (dashboard.stripe.com/webhooks ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=""
# ID des Price Stripe (Produits > créer un prix récurrent) pour chaque offre
STRIPE_PRICE_ECONOMIQUE=""
STRIPE_PRICE_CLASSIQUE=""
STRIPE_PRICE_PREMIUM=""
